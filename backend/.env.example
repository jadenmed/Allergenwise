# AllergenWise — Environment Variables
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to git.

# ─── App ───────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_NAME=AllergenWise
APP_URL=https://allergenwise.com

# ─── Supabase ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key — SERVER ONLY. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# ─── Stripe ───────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# ─── Resend (email) ───────────────────────────────────────────────────────────
RESEND_API_KEY=
RESEND_FROM_EMAIL=hello@allergenwise.com
REVIEWER_EMAIL=reviewers@allergenwise.com

# ─── Mux (video) ──────────────────────────────────────────────────────────────
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=
# MUX_SIGNING_KEY_ID: The "Key ID" shown on the Mux dashboard Signing Keys page.
# Example: "abc123def456ghi789"
MUX_SIGNING_KEY_ID=
# MUX_SIGNING_KEY_PRIVATE: The RSA private key PEM, BASE64-ENCODED.
# From Mux dashboard: Signing Keys → Create → copy the private key
# Then base64-encode it: base64 -i your_key.pem | tr -d '\n'
# (or: cat your_key.pem | base64 | tr -d '\n')
# The signMuxPlaybackUrl function decodes this with Buffer.from(key, 'base64').toString('utf-8')
MUX_SIGNING_KEY_PRIVATE=

# ─── Mapbox ───────────────────────────────────────────────────────────────────
NEXT_PUBLIC_MAPBOX_TOKEN=

# ─── Sentry (error tracking) ──────────────────────────────────────────────────
SENTRY_DSN=

# ─── Cron security ────────────────────────────────────────────────────────────
# CRON_SECRET: shared secret between Vercel Cron and your cron route handlers.
# Vercel injects this automatically as `Authorization: Bearer {CRON_SECRET}` on prod.
# For local testing: set any random string and pass the same header manually.
# Generate: openssl rand -hex 32
CRON_SECRET=

# ─── Database (used by db:seed script) ────────────────────────────────────────
DATABASE_URL=

# ─── Rate limiting (Wave 4B — P0 #10) ─────────────────────────────────────────
# Upstash Redis powers the rate limiter on /api/certs/[certCode]/verify.
# Vercel provisions both KV_REST_API_* vars automatically when the Upstash
# integration is added via the Vercel Marketplace.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# RATELIMIT_IP_PEPPER: secret salt prepended to every IP before SHA-256.
# Prevents reverse-mapping rate-limit keys to source IPs from a Redis
# disclosure. Rotation procedure documented in
# audits/cert-code-redesign-plan.md (d) — "Pepper rotation procedure".
# Generate: openssl rand -base64 32
RATELIMIT_IP_PEPPER=

# RATELIMIT_VERIFY_IP_PER_MIN: per-IP requests / 60s sliding window.
# Default: 10. Override without a code change.
RATELIMIT_VERIFY_IP_PER_MIN=10

# RATELIMIT_VERIFY_CODE_PER_MIN: per-cert-code requests / 60s sliding window.
# Default: 5. Override without a code change.
RATELIMIT_VERIFY_CODE_PER_MIN=5

# ─── Rate limiting (Wave-gate P1 — P1-14) ─────────────────────────────────────
# Per-route knobs for signup / invite-accept / invites-send. All sliding-window
# at 60 s. Defaults chosen so a legitimate admin onboarding a roster never
# trips them. Override to tighten without a code change.
RATELIMIT_SIGNUP_IP_PER_MIN=10
RATELIMIT_SIGNUP_EMAIL_PER_MIN=5
RATELIMIT_INVITE_ACCEPT_IP_PER_MIN=10
RATELIMIT_INVITE_ACCEPT_TOKEN_PER_MIN=5
RATELIMIT_INVITE_SEND_IP_PER_MIN=10
RATELIMIT_INVITE_SEND_RESTAURANT_PER_MIN=20

# ─── Rate limiting (Wave-gate P1 — P1-16 account deletion + export) ──────────
# Per-hour windows (vs the per-minute knobs above). The request + confirm
# limiters cap abuse vectors (CSRF-like adversary spamming deletion
# requests, brute-forcing a 256-bit confirmation token). The export
# limiters cap a heavy query.
RATELIMIT_ACCOUNT_DELETE_REQUEST_IP_PER_HOUR=5
RATELIMIT_ACCOUNT_DELETE_REQUEST_ACCT_PER_HOUR=5
RATELIMIT_ACCOUNT_DELETE_CONFIRM_IP_PER_HOUR=10
RATELIMIT_ACCOUNT_EXPORT_IP_PER_HOUR=5
RATELIMIT_ACCOUNT_EXPORT_ACCT_PER_HOUR=1

# ─── Live smoke test (Wave 4B — operator-runnable only) ───────────────────────
# Gates tests/integration/verify-rate-limit-live-smoke.test.ts.
# Set UPSTASH_LIVE_TEST=1 (plus the two _LIVE_TEST vars below pointing at a
# throwaway Upstash instance) to opt in. The regular suite skips this test.
# UPSTASH_LIVE_TEST=
# KV_REST_API_URL_LIVE_TEST=
# KV_REST_API_TOKEN_LIVE_TEST=

# T-03 — the pre-launch coming-soon gate. Server-only flag,
# never NEXT_PUBLIC_ (see lib/coming-soon.ts). DEFAULTS TO ON: the gate is
# enabled unless this is set to exactly "false". Absent, empty, misspelled or
# any other value keeps the gated surfaces PRIVATE — publishing takes a
# deliberate COMING_SOON=false, because the opposite mistake ships an
# unfinished product silently.
COMING_SOON=true
