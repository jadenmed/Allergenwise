{
  "name": "allergenwise",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:integration": "vitest run tests/integration",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:reset": "supabase db reset",
    "db:push": "supabase db push",
    "db:seed": "tsx scripts/seed-db.ts",
    "db:seed-auth": "tsx scripts/seed-auth-users.ts",
    "db:seed-with-auth": "pnpm db:seed-auth && pnpm db:seed",
    "email:dev": "email dev --dir lib/email/templates --port 3001"
  },
  "dependencies": {
    "@mux/mux-node": "8.8.0",
    "@react-pdf/renderer": "4.5.1",
    "@supabase/ssr": "0.9.0",
    "@supabase/supabase-js": "2.105.1",
    "@upstash/ratelimit": "2.0.8",
    "@upstash/redis": "1.38.0",
    "isomorphic-dompurify": "3.12.0",
    "jsonwebtoken": "9.0.3",
    "next": "14.2.35",
    "papaparse": "5.5.3",
    "qrcode": "1.5.4",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "resend": "4.8.0",
    "server-only": "0.0.1",
    "sharp": "0.33.5",
    "stripe": "17.7.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@playwright/test": "1.59.1",
    "@types/jsonwebtoken": "9.0.10",
    "@types/node": "20.19.39",
    "@types/papaparse": "5.5.2",
    "@types/qrcode": "1.5.6",
    "@types/react": "18.3.28",
    "@types/react-dom": "18.3.7",
    "dotenv": "16.6.1",
    "eslint": "8.57.1",
    "eslint-config-next": "14.2.30",
    "jsdom": "25.0.1",
    "prettier": "3.8.3",
    "supabase": "^2.111.0",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "vitest": "2.1.9"
  }
}
