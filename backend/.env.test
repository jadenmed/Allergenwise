# .env.test — COMMITTED ON PURPOSE. Loaded by vitest.config.ts with override:true.
#
# Nothing in this file is a secret. Every value below is either a loopback
# address or one of the fixed demo JWTs that `supabase start` prints on every
# developer's machine, byte for byte. They are signed with the Supabase CLI's
# published default JWT secret and are worthless against any hosted project.
#
# Why it exists (T-24): fourteen files under tests/integration/ call
# `config({ path: '.env.local' })` at module scope, so the suite loaded the
# hosted production credentials with no `source` and no opt-in. dotenv does not
# overwrite variables that are already set, so loading this file FIRST — and
# with override:true — makes those in-test .env.local loads no-ops.
#
# Rules for this file:
#   - Every URL here must be localhost or 127.0.0.1. tests/env-guard.ts fails
#     the run if that ever stops being true.
#   - Do not add real credentials. Put machine-specific or secret values in
#     .env.test.local, which is gitignored.

NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImV4cCI6MTk4MzgxMjk5Nn0.EGIM96RAZx35lJzdJsyH-qQwv8Hdp7fsn3W0YpN81IU

# Local Postgres behind the same stack. This is the value
# tests/integration/migration-0013-cert-state.test.ts:18 already defaults to.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# TEST_DATABASE_URL is deliberately NOT set here. Setting it flips
# `describe.runIf(TEST_DB)` in subscriptions-invoice-unique.test.ts from skipped
# to running, which would change what the suite does. Set it yourself, to a
# 127.0.0.1 URL, when you want that live-migration suite.
